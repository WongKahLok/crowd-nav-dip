# policy configurations for robot

[rl]
gamma = 0.9


[om]
cell_num = 4
cell_size = 1
om_channel_size = 3


[action_space]
kinematics = holonomic
# action space size is speed_samples * rotation_samples + 1
speed_samples = 5
rotation_samples = 16
sampling = exponential
query_env = true


[cadrl]
mlp_dims = 150, 100, 100, 1
multiagent_training = false


[lstm_rl]
global_state_dim = 50
mlp1_dims = 150, 100, 100, 50
mlp2_dims = 150, 100, 100, 1
multiagent_training = true
with_om = false
with_interaction_module = false


[srl]
mlp1_dims = 150, 100, 100, 50
mlp2_dims = 150, 100, 100, 1
multiagent_training = true
with_om = false


[sarl]
mlp1_dims = 150, 100
mlp2_dims = 100, 50
attention_dims = 100, 100, 1
mlp3_dims = 150, 100, 100, 1
multiagent_training = true
with_om = false
with_global_state = true

[motion]
# Kinematic limits used to build the candidate actions from the current
# velocity each step. constrained = false restores the fixed action set.
constrained = true
# m/s^2
max_accel = 0.5
max_decel = 0.5
# deg/s, limits how fast the direction of motion may change while moving
max_turn_rate = 60
# heading samples inside the turn window (the current heading is always one)
heading_samples = 7
# below this speed the ship counts as at rest
stop_speed = 0.05
# false: a ship at rest keeps its last course and sets off within the turn window;
# true: it may set off in any direction (the behaviour before 2026-10-28)
turn_at_rest = false
# seconds a ship may stand still before it is helped on: one parked on its local goal
# gets a goal further along, any other is pushed at top safe speed for push_time seconds
# towards the most open water. 0 turns this off
stall_time = 10
push_time = 2
# value penalty per radian of heading change, keeps close scores on the
# current course; a ship at rest and the stop action pay nothing
continuity_weight = 0.01


[safety]
# extra gap (m) a candidate must keep from land / map edge and from other ships
safety_margin_static = 0.2
safety_margin_dynamic = 0.2
# also require room to stop at max_decel after the next step, and that the
# stopped ship stays clear of the extrapolated ships for safety_horizon seconds
braking_check = true
safety_horizon = 3.0
